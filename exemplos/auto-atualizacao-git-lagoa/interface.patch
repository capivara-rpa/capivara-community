+async function alternarAutoAtualizar(processoId, ativo) {
+    try {
+        await enviarJSON(`/api/orq/processos/${Number(processoId)}/auto-atualizar`, { ativo });
+        carregar();
+    } catch (erro) {
+        alert("Falha ao alterar auto-atualização: " + erro.message);
+    }
